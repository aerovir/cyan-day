# ===== Ключи и токены =====
# Заполните .env локально; не коммитьте реальные значения.
VK_TOKEN=
VK_GROUP_ID=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# ===== Runtime =====
# Контейнер запускается от непривилегированного пользователя.
LOG_LEVEL=INFO

# ===== Расписание =====
# Фиксированный UTC+2, без сезонного перевода времени.
BOT_TIMEZONE=Etc/GMT-2
SLOT_TIMES=12:00,14:00,16:00,18:00,20:00,22:00
SCHEDULE_POLL_SECONDS=20
SLOT_GRACE_SECONDS=300
# Только для legacy-режима.
POST_HOUR=9
POST_MINUTE=0
# Переводить зависшие попытки публикации в unknown после этого времени.
PUBLICATION_STALE_SECONDS=3600

# ===== Защита от лимитов Gemini =====
# max_retries — общее число HTTP-запросов, включая первый.
GEMINI_MAX_RETRIES=3
GEMINI_RATE_LIMIT_RETRIES=2
GEMINI_TRANSIENT_RETRIES=2
GEMINI_BACKOFF_BASE_SECONDS=2
GEMINI_BACKOFF_MAX_SECONDS=30
GEMINI_RATE_LIMIT_COOLDOWN_SECONDS=300
GEMINI_RATE_LIMIT_COOLDOWN_MAX_SECONDS=3600

# ===== Генерация и контент =====
CONTENT_DB=state/content.sqlite3
CONTENT_MODE=cards
MAX_HOLIDAYS=3
WITH_PHOTOS=false
ALLOW_CARD_REUSE=false

# ===== Изображения =====
# none — без изображений; pollinations — Pollinations; cloudflare — Cloudflare Workers AI.
IMAGE_PROVIDER=none
IMAGE_BASE_URL=https://image.pollinations.ai/prompt
IMAGE_MODEL=flux
IMAGE_TIMEOUT_SECONDS=30
# При ошибке генерации опубликовать пост без изображения.
IMAGE_FALLBACK_TO_TEXT=true

# ===== Cloudflare Workers AI (используется только при IMAGE_PROVIDER=cloudflare) =====
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell
CLOUDFLARE_IMAGE_TIMEOUT_SECONDS=90

# ===== Источники =====
SOURCE_REGISTRY_DB=state/sources.sqlite3
SOURCE_REGISTRY_MODE=auto
