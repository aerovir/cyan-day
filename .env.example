# ===== Ключи и токены =====
# Заполните .env локально; не коммитьте реальные значения.
VK_TOKEN=
VK_GROUP_ID=
MISTRAL_API_KEY=

# ===== Runtime =====
# Контейнер запускается от непривилегированного пользователя.
LOG_LEVEL=INFO

# ===== Расписание =====
POST_HOUR=9
POST_MINUTE=0
BOT_TIMEZONE=Europe/Moscow
SLOT_TIMES=09:00,10:30,12:00,13:30,15:00,17:00,19:00
DAILY_POSTS=7
MAX_CATCHUP_SLOTS=7
SCHEDULE_POLL_SECONDS=20

# ===== Генерация и контент =====
MISTRAL_MODEL=mistral-small-latest
CONTENT_DB=state/content.sqlite3
CONTENT_MODE=legacy
MAX_HOLIDAYS=3
WITH_PHOTOS=false
ALLOW_CARD_REUSE=false

# ===== Изображения =====
# none — не генерировать изображения; pollinations — Pollinations Image API.
IMAGE_PROVIDER=none
IMAGE_BASE_URL=https://image.pollinations.ai/prompt
IMAGE_MODEL=flux
IMAGE_TIMEOUT_SECONDS=30
# При ошибке генерации опубликовать пост без изображения.
IMAGE_FALLBACK_TO_TEXT=true

# ===== Источники =====
SOURCE_REGISTRY_DB=state/sources.sqlite3
SOURCE_REGISTRY_MODE=auto
