# ===== Ключи и токены =====
# VK: токен сообщества (группы) с правами wall и groups.
# Получить: https://vk.com/club<ID>?act=edit&section=api (или https://dev.vk.com)
VK_TOKEN=

# VK: ID группы, в которую постим (без минуса). Пример: 123456789
VK_GROUP_ID=

# Mistral AI: API-ключ (тариф Experiment — бесплатно).
# Получить: https://console.mistral.ai/api-keys
# ВАЖНО: в локальном .env для реального запуска, в GitHub Actions — из секретов.
MISTRAL_API_KEY=

# ===== Настройки бота =====
# Час и минута ежедневного запуска (локальное время контейнера)
POST_HOUR=9
POST_MINUTE=0

# Модель Mistral для генерации текста
MISTRAL_MODEL=mistral-small-latest

# Максимальное количество праздников в день (сколько постов)
MAX_HOLIDAYS=3

# Публиковать с картинками. false — только текст (надёжно с токеном
# сообщества). true — с картинками (нужен user-токен, иначе VK ошибка 27).
WITH_PHOTOS=false

# SQLite-реестр источников (путь внутри контейнера сохраняется в volume bot_state)
SOURCE_REGISTRY_DB=state/sources.sqlite3
# auto: legacy calend.ru, пока нет включённых источников; registry: только реестр; legacy: принудительный fallback
SOURCE_REGISTRY_MODE=auto

# Уровень логирования: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
